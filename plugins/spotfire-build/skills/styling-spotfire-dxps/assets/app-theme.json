{
  "general": {
    "baseTheme": "LightSfx",
    "baseThemeSfx": "LightSfx",
    "font-family": "Roboto",
    "color": "rgb(31, 35, 40)",
    "baseColor": "rgb(250, 250, 248)",
    "activePageTabBackgroundColor": "rgb(250, 250, 248)",
    "accentColor": "rgb(48, 80, 239)",
    "activeVisualizationBorderColor": "rgb(48, 80, 239)",
    "visualizationMargin": 4
  },
  "rules": [
    {
      "containmentNode": "page-navigation-bar",
      "box": {
        "font-family": "Roboto",
        "font-size": 11,
        "color": "rgb(31, 35, 40)"
      }
    },
    {
      "containmentNode": "visualization-area",
      "box": {
        "background-color": "rgb(250, 250, 248)",
        "padding-top": 4,
        "padding-right": 4,
        "padding-bottom": 4,
        "padding-left": 4
      }
    },
    {
      "containmentNode": "visual",
      "box": {
        "background-color": "rgb(255, 255, 255)",
        "color": "rgb(31, 35, 40)",
        "font-size": 9,
        "border-style": "solid",
        "border-width": 1,
        "border-color": "rgb(220, 223, 228)",
        "border-radius": 4,
        "padding": 2
      }
    },
    {
      "containmentNode": "visual-title",
      "box": {
        "font-family": "Roboto",
        "font-size": 12,
        "font-weight": "Bold",
        "color": "rgb(31, 35, 40)",
        "background-color": "transparent",
        "padding-top": 4,
        "padding-right": 6,
        "padding-bottom": 4,
        "padding-left": 8
      }
    },
    {
      "containmentNode": "scale-area",
      "box": {
        "font-family": "Roboto",
        "font-size": 9,
        "color": "rgb(91, 99, 112)"
      }
    },
    {
      "containmentNode": "scale-line",
      "box": {
        "stroke": "rgb(208, 213, 221)"
      }
    },
    {
      "containmentNode": "scale-tick",
      "box": {
        "stroke": "rgb(208, 213, 221)"
      }
    },
    {
      "containmentNode": "table-cell:odd-row",
      "box": {
        "background-color": "transparent"
      }
    }
  ]
}
