        "server": "mods-dev-server . --allow-project-root true"
    },
    "devDependencies": {
        "@spotfire/mods-api": "~2.5.0",
        "@spotfire/mods-dev-server": "^1.3.0",
        "typescript": "^5.9.3"
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
