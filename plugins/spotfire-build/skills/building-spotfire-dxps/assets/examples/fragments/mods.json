          "postScript": "from Spotfire.Dxp.Application.Visuals import CategoryMode\ncontent.Axis(\"Event\").CategoryMode = CategoryMode.ShowAll\n"
        },
        {
          "id": "eventCards",
          "type": "mod",
          "modId": "text-card-mod",
          "title": "Event Log",
