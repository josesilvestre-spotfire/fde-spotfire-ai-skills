          "settings": {"UseSeparateColorForMarkedItems": true},
          "axes": {
            "Card by": "<baserowid()>",
            "Content": "<[Description]>",
            "Annotation": "<[Pump ID] NEST [Severity] NEST [Start]>",
            "Sorting": "First([Start])",
            "Tooltip": "<>",
            "Color": "<[Severity]>"
          },
          "properties": {
            "sortOrder": "desc",
            "useCustomCardBy": true
          }
        },
        {
          "id": "pressureGauge",
          "type": "mod",
          "modId": "pump-pressure-gauge-mod",
          "title": "Pressure Gauge",
          "table": "PUMP_DATA",
          "axes": {
